ARG ELIXIR_VERSION=1.19.5
ARG OTP_VERSION=27.3.4.10
ARG DEBIAN_VERSION=bookworm-20260610-slim

ARG BUILDER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"
ARG RUNNER_IMAGE="docker.io/debian:${DEBIAN_VERSION}"

FROM ${BUILDER_IMAGE} AS builder
ARG COMMIT_SHA
ENV COMMIT_SHA=$COMMIT_SHA

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git curl ca-certificates \
  && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force
ENV MIX_ENV="prod"

COPY mix.exs mix.lock ./
RUN mix deps.get --only $MIX_ENV
RUN mkdir config

COPY assets/package.json assets/package-lock.json* ./assets/
RUN npm install --prefix assets --progress=false --silent

COPY config/config.exs config/${MIX_ENV}.exs config/
RUN mix deps.compile

COPY assets/postcss.config.js ./assets/
RUN mix assets.setup
COPY priv priv
COPY lib lib
RUN mix compile

COPY assets assets
RUN mix assets.deploy

COPY config/runtime.exs config/
COPY rel rel
RUN mix release runner_script

FROM ${RUNNER_IMAGE} AS final

# The script-family runner executes Python submissions inside isolate. It
# needs the python3 interpreter plus the toolchain to build isolate itself
# (gcc/libc6-dev/make/libcap-dev/pkg-config/libseccomp-dev/libsystemd-dev) —
# no g++, that's the compiled family's job. libc6-dev is spelled out
# explicitly: it's only a Recommends of the `gcc` package, so
# --no-install-recommends won't pull it in on its own and gcc can't compile
# anything (missing stdint.h etc.) without it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 openssl libncurses6 locales ca-certificates \
    python3 \
    git make gcc libc6-dev libcap-dev pkg-config libseccomp-dev libsystemd-dev \
  && rm -rf /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Pin isolate to a specific release so the sandbox binary is reproducible
# across builds instead of floating with upstream's default branch.
ARG ISOLATE_REF=v2.7
RUN git clone --branch ${ISOLATE_REF} --depth 1 https://github.com/ioi/isolate.git /tmp/isolate \
  && cd /tmp/isolate \
  && make isolate \
  && make install \
  && rm -rf /tmp/isolate \
  && ln -s /usr/local/bin/isolate /usr/bin/isolate

RUN useradd -r -s /bin/false isolate \
  && echo "isolate:100000:65536" >> /etc/subuid \
  && echo "isolate:100000:65536" >> /etc/subgid \
  && echo "root:100000:65536" >> /etc/subuid \
  && echo "root:100000:65536" >> /etc/subgid

RUN mkdir -p /run/isolate/locks /var/local/lib/isolate \
  && chmod 777 /var/local/lib/isolate

WORKDIR "/app"
ENV MIX_ENV="prod"
ENV RELEASE_NAME="runner_script"

# Isolate runs privileged and needs root to manage cgroups, so unlike the
# web/db images this one does not drop to an unprivileged user.
COPY --from=builder /app/_build/${MIX_ENV}/rel/runner_script ./

CMD ["/app/bin/entrypoint"]
