#!/bin/sh
set -eu
export ZIG_GLOBAL_CACHE_DIR="$PWD/.cache/zig-global" ZIG_LOCAL_CACHE_DIR="$PWD/.cache/zig-local"
# With one compile job and private caches, these advisory locks are unnecessary.
# Emulate success without issuing flock: isolate's kernel filter stays enabled.
# The tracer is used only for compilation, never for submitted executables.
exec /usr/bin/strace -f -qq -o /dev/null -e trace=flock -e inject=flock:retval=0 -- /usr/local/zig/zig build-exe -j1 main.zig -lc -O ReleaseSafe -femit-bin=out
