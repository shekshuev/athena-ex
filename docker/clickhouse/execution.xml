<clickhouse>
  <!-- Untrusted SQL must not create engines that access the network or filesystem. -->
  <access_control_improvements>
    <table_engines_require_grant>true</table_engines_require_grant>
  </access_control_improvements>
  <max_server_memory_usage>1073741824</max_server_memory_usage>
  <max_concurrent_queries>8</max_concurrent_queries>
  <logger>
    <level>warning</level>
  </logger>
</clickhouse>
