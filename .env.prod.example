# Which Ubuntu version's isolate build to pull: "u22", "u24", or "u20"
# (default u24). Must match the host's actual Ubuntu version — see
# docker-compose.prod.yml. "u20" is glibc-matched only, not kernel-validated
# in CI (GitHub retired hosted ubuntu-20.04 runners) — see docker-compose.prod.yml.
IMAGE_OS=u24
PHX_SERVER=true
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=5Yk/sIwxBbUtp6A1yrq6wdpXlqQcyAD/OU4/dB9RwF1fk25NM7AF0GvKOnOzlGeu
POSTGRES_USER=athena_prod_user
POSTGRES_PASSWORD=StrongDBPassword!
POSTGRES_RUNNER_PASSWORD=StrongRunnerPassword!
POSTGRES_DB=athena_prod
POSTGRES_PORT_EXTERNAL=5432
DATABASE_URL=ecto://athena_prod_user:StrongDBPassword!@postgres:5432/athena_prod
POOL_SIZE=10
MINIO_ROOT_USER=athena_admin
MINIO_ROOT_PASSWORD=StrongMinioPassword!
MINIO_ACCESS_KEY=athena_admin
MINIO_SECRET_KEY=StrongMinioPassword!
MINIO_HOST=minio
MINIO_PUBLIC_HOST=localhost
MINIO_PORT=9000
MINIO_PORT_EXTERNAL=9000
MINIO_CONSOLE_PORT_EXTERNAL=9001
MINIO_SCHEME=http://
MINIO_BUCKET=athena
MEDIA_CLEANUP_CRON="0 * * * *"
GAMIFICATION_ROLLUP_CRON="5 0 * * MON"
DAILY_CHALLENGE_CLEANUP_CRON="15 0 * * *"
EPMD_PORT_EXTERNAL=4369
GOSSIP_PORT_EXTERNAL=45892
FORCE_SSL=false
DEFAULT_LOCALE=en
